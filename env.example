# Veritabanı (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=work_report_db
POSTGRES_PORT=5432

# E-posta gönderimi (SMTP)
# Bu dosyayı .env.local olarak kopyalayıp düzenleyin. E-posta göndermek için:
# ENABLE_EMAIL_SEND=true yapın ve SMTP bilgilerini doldurun.
# Gmail: 2 adımlı doğrulama açıksa "Uygulama şifresi" kullanın.
ENABLE_EMAIL_SEND=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=rapor@yourcompany.com
