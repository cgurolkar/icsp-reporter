# Veritabanı (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_DB=work_report_db
POSTGRES_PORT=5432

# E-posta gönderimi (SMTP)
# Bu dosyayı .env.local olarak kopyalayıp düzenleyin. E-posta göndermek için:
# ENABLE_EMAIL_SEND=true yapın ve SMTP bilgilerini doldurun.
# Gmail: 2 adımlı doğrulama açıksa "Uygulama şifresi" kullanın.
# Şifrede @, # veya boşluk varsa mutlaka çift tırnak: SMTP_PASSWORD="sizin@şifre"
# Kurumsal posta: 465 SSL (SMTP_SECURE=true) veya 587 STARTTLS (SMTP_SECURE=false) — biri çalışmazsa diğerini deneyin.
# Geçici teşhis: SMTP_DEBUG=true (konsolda SMTP logu)
# Cert alan adı farklıysa (ör. host mail.x.com, sertifika *.natrohost.com): SMTP_TLS_SERVERNAME=natrohost.com
# SMTP_TLS_INSECURE=true — sadece geçici; sertifika doğrulamasını kapatır
ENABLE_EMAIL_SEND=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=rapor@yourcompany.com
